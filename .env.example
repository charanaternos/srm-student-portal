# SRM Portal Credentials & Selectors
SRM_LOGIN_URL=https://sp.srmist.edu.in/srmiststudentportal/students/loginManager/youLogin.jsp
SRM_USERNAME=your_netid_without_domain
SRM_PASSWORD=your_password
SRM_USERNAME_SELECTOR=input[name="txtUserName"], #txtUserName, input[placeholder*="NetID"]
SRM_PASSWORD_SELECTOR=input[type="password"]
SRM_SUBMIT_SELECTOR=button[type="submit"], input[type="submit"], .btn-login
SRM_LOGIN_SUCCESS_SELECTOR=#dashboard, .user-profile, a[href*="logout"]

# Sections (URLs & CSS Table Selectors)
SRM_ATTENDANCE_URL=https://sp.srmist.edu.in/srmiststudentportal/students/report/attendanceReport.jsp
SRM_ATTENDANCE_TABLE_SELECTOR=table#attendanceTable, table.table-striped
SRM_CLASSES_URL=https://sp.srmist.edu.in/srmiststudentportal/students/report/timeTable.jsp
SRM_CLASSES_TABLE_SELECTOR=table#timeTable, table.timetable
SRM_MARKS_URL=https://sp.srmist.edu.in/srmiststudentportal/students/report/internalMarksReport.jsp
SRM_MARKS_TABLE_SELECTOR=table#marksTable, table.marks

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
SUPABASE_USER_ID=00000000-0000-0000-0000-000000000000
PORTAL_TIMEZONE=Asia/Kolkata

# Optional: set to false to open a visible browser window (to manually enter the CAPTCHA)
HEADLESS=false

